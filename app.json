{
  "expo": {
    "name": "AasraAI",
    "slug": "aasraai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aasraai",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.aasraai.app",
      "permissions": [
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "CALL_PHONE",
        "SEND_SMS",
        "READ_SMS",
        "ACCESS_FINE_LOCATION",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-contacts"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
